# Django Secret Key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=

# Debug mode (True for development, False for production)
DEBUG=True

# Database URL (sqlite for dev, postgres for prod)
# Examples:
#   sqlite:///db.sqlite3
#   postgres://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=*

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sistema Facturación <noreply@facturacion.com>