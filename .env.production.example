# =============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN — SISTEMA DE FACTURACIÓN POS
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env en tu servidor VPS/Cloud
# 2. REEMPLAZA TODOS LOS VALORES CON DATOS REALES (nunca uses los ejemplos)
# 3. Genera una SECRET_KEY segura: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 4. Configura PostgreSQL en tu servidor antes de desplegar
# 5. Configura tu dominio real en ALLOWED_HOSTS
# 6. Usa contraseña de aplicación SMTP (no tu contraseña principal de email)
# 7. Asegúrate de tener certificado SSL/TLS válido (Let's Encrypt recomendado)
# =============================================================================

# -----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------
# SECRET_KEY: Genera una NUEVA clave aleatoria de 50+ caracteres para producción
# COMANDO: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=generate-a-secure-50-character-random-key-here

# DEBUG: SIEMPRE False en producción — expone información sensible si True
DEBUG=False

# ALLOWED_HOSTS: Lista de dominios permitidos (separados por coma)
# EJEMPLO: midominio.com,www.midominio.com,api.midominio.com
# NUNCA uses '*' en producción
ALLOWED_HOSTS=midominio.com,www.midominio.com

# -----------------------------------------------------------------------------
# BASE DE DATOS — PostgreSQL REQUERIDO EN PRODUCCIÓN
# -----------------------------------------------------------------------------
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
# Crea la BD y usuario en PostgreSQL antes de migrar:
#   CREATE DATABASE facturacion_db;
#   CREATE USER facturacion_user WITH PASSWORD 'password_seguro';
#   GRANT ALL PRIVILEGES ON DATABASE facturacion_db TO facturacion_user;
DATABASE_URL=postgres://usuario:password@localhost:5432/facturacion_db

# -----------------------------------------------------------------------------
# SEGURIDAD HTTPS / COOKIES / HEADERS — OBLIGATORIO EN PRODUCCIÓN
# -----------------------------------------------------------------------------
# Forzar HTTPS en todas las conexiones (requiere certificado SSL válido)
SECURE_SSL_REDIRECT=True

# Cookies solo seguras (HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Protección XSS del navegador
SECURE_BROWSER_XSS_FILTER=True

# Evitar MIME type sniffing
SECURE_CONTENT_TYPE_NOSNIFF=True

# Prevenir clickjacking (iframe embedding)
X_FRAME_OPTIONS=DENY

# HSTS: Forzar HTTPS por 1 año (31536000 segundos)
# ADVERTENCIA: Solo activa DESPUÉS de confirmar que HTTPS funciona correctamente
# Un error aquí puede hacer tu sitio inaccesible por 1 año
SECURE_HSTS_SECONDS=31536000

# Incluir subdominios en HSTS
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Permitir precarga HSTS en navegadores (requiere registro en hstspreload.org)
SECURE_HSTS_PRELOAD=True

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE EMAIL — SMTP REAL REQUERIDO
# -----------------------------------------------------------------------------
# Backend SMTP para producción
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Servidor SMTP (ejemplos comunes):
#   Gmail: smtp.gmail.com:587 (TLS)
#   Outlook: smtp.office365.com:587 (TLS)
#   SendGrid: smtp.sendgrid.net:587 (TLS)
#   Amazon SES: email-smtp.region.amazonaws.com:587 (TLS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credenciales SMTP — USA CONTRASEÑA DE APLICACIÓN (no tu password principal)
# Gmail: https://myaccount.google.com/apppasswords
# Outlook: https://account.live.com/proofs/manage
EMAIL_HOST_USER=tu_correo_real@dominio.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion_smtp

# Email remitente por defecto
DEFAULT_FROM_EMAIL=Sistema Facturación <noreply@midominio.com>
EMAIL_SUBJECT_PREFIX=[Facturación]

# -----------------------------------------------------------------------------
# CONFIGURACIONES ADICIONALES RECOMENDADAS
# -----------------------------------------------------------------------------
# Zona horaria (America/Caracas para Venezuela)
TIME_ZONE=America/Caracas

# Idioma
LANGUAGE_CODE=es-ve

# Prefijo de sesión (opcional, para multi-sitio)
# SESSION_COOKIE_NAME=facturacion_sessionid

# Tiempo de expiración de sesión (8 horas = 28800 segundos)
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CSRF
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com

# Logging (configurar en settings.py para producción)
# LOG_LEVEL=INFO

# =============================================================================
# CHECKLIST PRE-DESPLIEGUE
# =============================================================================
# [ ] SECRET_KEY generada nueva y única
# [ ] DEBUG=False
# [ ] ALLOWED_HOSTS con tu dominio real
# [ ] PostgreSQL instalado y BD creada
# [ ] DATABASE_URL apunta a PostgreSQL (no sqlite)
# [ ] Certificado SSL/TLS instalado (Let's Encrypt o comercial)
# [ ] SECURE_SSL_REDIRECT=True (después de probar HTTPS)
# [ ] HSTS activado (SECURE_HSTS_SECONDS=31536000)
# [ ] Email SMTP configurado con password de aplicación
# [ ] collectstatic ejecutado
# [ ] migrate ejecutado
# [ ] Superusuario creado (python manage.py createsuperuser)
# [ ] Permisos de carpetas media/ y static/ correctos
# [ ] Firewall: solo puertos 80, 443, 22 (SSH) abiertos
# [ ] Backups automáticos de BD configurados
# [ ] Monitoreo/logs centralizados configurados
# =============================================================================